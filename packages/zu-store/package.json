{
	"name": "@ez-kit/zu-store",
	"version": "0.8.0",
	"description": "Zustand store factory bound to React context, with undo/redo history and a keep-alive store cache.",
	"keywords": [
		"zustand",
		"react",
		"store",
		"context",
		"state-management",
		"undo-redo",
		"history",
		"persist",
		"url-state",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/zu-store"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/zu-store#readme",
	"bugs": {
		"url": "https://github.com/ez-kit/ez-kit/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./history": {
			"types": "./dist/history/index.d.ts",
			"import": "./dist/history/index.js"
		},
		"./persist": {
			"types": "./dist/persist/index.d.ts",
			"import": "./dist/persist/index.js"
		},
		"./persist/storage": {
			"types": "./dist/persist/storage/index.d.ts",
			"import": "./dist/persist/storage/index.js"
		},
		"./persist/url": {
			"types": "./dist/persist/url/index.d.ts",
			"import": "./dist/persist/url/index.js"
		},
		"./persist/url/react-router": {
			"types": "./dist/persist/url/react-router.d.ts",
			"import": "./dist/persist/url/react-router.js"
		},
		"./persist/url/next": {
			"types": "./dist/persist/url/next.d.ts",
			"import": "./dist/persist/url/next.js"
		},
		"./persist/validators/zod": {
			"types": "./dist/persist/validators/zod.d.ts",
			"import": "./dist/persist/validators/zod.js"
		},
		"./persist/testing": {
			"types": "./dist/persist/testing/index.d.ts",
			"import": "./dist/persist/testing/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "6.5 KB"
		},
		{
			"path": "dist/history/index.js",
			"limit": "2 KB"
		},
		{
			"path": "dist/persist/index.js",
			"limit": "6.5 KB"
		},
		{
			"path": "dist/persist/storage/index.js",
			"limit": "2 KB"
		},
		{
			"path": "dist/persist/url/index.js",
			"limit": "1 KB"
		},
		{
			"path": "dist/persist/url/react-router.js",
			"limit": "1 KB"
		}
	],
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"next": "16.2.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.9.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"dependencies": {
		"@ez-kit/store-core": "workspace:^",
		"@ez-kit/store-persist": "workspace:^"
	},
	"peerDependencies": {
		"next": ">=14.0.0",
		"react": ">=18.0.0",
		"react-router": ">=6.0.0",
		"zod": ">=3.0.0",
		"zustand": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react-router": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	}
}
