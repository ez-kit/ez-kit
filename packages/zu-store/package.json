{
	"name": "@ez-kit/zu-store",
	"version": "0.5.0",
	"description": "A reusable utility package for ez-kit.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/zu-store"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/zu-store#readme",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --sourcemap",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"format": "node ../../scripts/prettier.mjs --write",
		"format:check": "node ../../scripts/prettier.mjs --check",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "50 KB"
		}
	],
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zustand": "^5.0.12"
	},
	"dependencies": {
		"@ez-kit/store-core": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"zustand": "^5.0.0"
	}
}
