{
	"name": "@ez-kit/data-grid-native",
	"version": "0.1.1",
	"description": "Plain/native UI flavour of @ez-kit/data-grid (ships its own global.css).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/data-grid/react/native"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/data-grid/react/native#readme",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./global.css": "./dist/global.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --sourcemap && cp src/global.css dist/global.css",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "500 KB"
		}
	],
	"dependencies": {
		"@ez-kit/data-grid-react": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.577.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	}
}
