{
	"name": "@ez-kit/data-grid-heroui",
	"version": "0.0.0",
	"private": true,
	"description": "HeroUI package for @ez-kit/data-grid/react.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./global.css": "./src/global.css"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --sourcemap",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier . --write",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "50 KB"
		}
	],
	"dependencies": {
		"@heroui/react": "^3.0.3",
		"@heroui/styles": "^3.0.3"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	}
}
