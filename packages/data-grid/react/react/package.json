{
	"name": "@ez-kit/data-grid-react",
	"version": "0.19.0",
	"description": "Framework-agnostic React adapter for @ez-kit/data-grid — headless render layer with zero visual styling.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/data-grid/react/react"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/data-grid/react/react#readme",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./state": {
			"types": "./dist/state/index.d.ts",
			"import": "./dist/state/index.js",
			"default": "./dist/state/index.js"
		},
		"./cell-types": {
			"types": "./dist/cell-types/index.d.ts",
			"import": "./dist/cell-types/index.js",
			"default": "./dist/cell-types/index.js"
		},
		"./contract": {
			"types": "./dist/contract.d.ts",
			"import": "./dist/contract.js",
			"default": "./dist/contract.js"
		},
		"./kit": {
			"types": "./dist/kit.d.ts",
			"import": "./dist/kit.js",
			"default": "./dist/kit.js"
		},
		"./menu": {
			"types": "./dist/menu.d.ts",
			"import": "./dist/menu.js",
			"default": "./dist/menu.js"
		},
		"./styles.css": "./dist/styles.css",
		"./dnd-kit": {
			"types": "./dist/dnd-kit/index.d.ts",
			"import": "./dist/dnd-kit/index.js",
			"default": "./dist/dnd-kit/index.js"
		},
		"./features": {
			"types": "./dist/features/index.d.ts",
			"import": "./dist/features/index.js",
			"default": "./dist/features/index.js"
		},
		"./features/all": {
			"types": "./dist/features/all.d.ts",
			"import": "./dist/features/all.js",
			"default": "./dist/features/all.js"
		},
		"./operators": {
			"types": "./dist/operators/index.d.ts",
			"import": "./dist/operators/index.js",
			"default": "./dist/operators/index.js"
		},
		"./messages/en": {
			"types": "./dist/messages/en.d.ts",
			"import": "./dist/messages/en.js",
			"default": "./dist/messages/en.js"
		},
		"./messages/ru": {
			"types": "./dist/messages/ru.d.ts",
			"import": "./dist/messages/ru.js",
			"default": "./dist/messages/ru.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup && cp src/styles/global.css dist/styles.css",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage",
		"test:react18": "vitest run --config vitest.react18.config.ts"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "43.5 KB",
			"ignore": [
				"@ez-kit/data-grid-core",
				"@tanstack/react-store",
				"@tanstack/react-table",
				"@tanstack/react-virtual",
				"@tanstack/table-core"
			]
		},
		{
			"path": "dist/state/index.js",
			"limit": "940 B",
			"ignore": [
				"@ez-kit/data-grid-core",
				"@tanstack/react-store",
				"@tanstack/react-table",
				"@tanstack/react-virtual",
				"@tanstack/table-core"
			]
		},
		{
			"path": "dist/cell-types/index.js",
			"limit": "840 B",
			"ignore": [
				"@ez-kit/data-grid-core",
				"@tanstack/react-store",
				"@tanstack/react-table",
				"@tanstack/react-virtual",
				"@tanstack/table-core"
			]
		},
		{
			"path": "dist/contract.js",
			"limit": "610 B",
			"ignore": [
				"@ez-kit/data-grid-core",
				"@tanstack/react-store",
				"@tanstack/react-table",
				"@tanstack/react-virtual",
				"@tanstack/table-core"
			]
		},
		{
			"path": "dist/menu.js",
			"limit": "260 B",
			"ignore": [
				"@ez-kit/data-grid-core",
				"@tanstack/react-store",
				"@tanstack/react-table",
				"@tanstack/react-virtual",
				"@tanstack/table-core"
			]
		},
		{
			"path": "dist/dnd-kit/index.js",
			"limit": "2.2 kB",
			"ignore": [
				"@ez-kit/data-grid-core",
				"@tanstack/react-store",
				"@tanstack/react-table",
				"@tanstack/react-virtual",
				"@tanstack/table-core"
			]
		}
	],
	"dependencies": {
		"@ez-kit/data-grid-core": "workspace:^",
		"@tanstack/react-store": "^0.11.2",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/react-virtual": "^3.14.25",
		"@tanstack/table-core": "^9.3.1"
	},
	"devDependencies": {
		"@dnd-kit/dom": "^0.5.3",
		"@dnd-kit/react": "^0.5.3",
		"@ez-kit/react18-env": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"peerDependencies": {
		"@dnd-kit/dom": "^0.5.3",
		"@dnd-kit/react": "^0.5.3",
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"@dnd-kit/dom": {
			"optional": true
		},
		"@dnd-kit/react": {
			"optional": true
		}
	}
}
