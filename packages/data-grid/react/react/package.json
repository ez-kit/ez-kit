{
	"name": "@ez-kit/data-grid-react",
	"version": "0.0.0",
	"description": "Framework-agnostic React adapter for @ez-kit/data-grid — headless render layer with zero visual styling.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/data-grid/react/react"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/data-grid/react/react#readme",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./cell-types": {
			"types": "./dist/cell-types/index.d.ts",
			"import": "./dist/cell-types/index.js",
			"default": "./dist/cell-types/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup src/index.ts src/cell-types/index.ts --format esm --dts --sourcemap && cp src/styles/global.css dist/styles.css",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"format": "node ../../../../scripts/prettier.mjs --write",
		"format:check": "node ../../../../scripts/prettier.mjs --check",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "50 KB"
		},
		{
			"path": "dist/cell-types/index.js",
			"limit": "5 KB"
		}
	],
	"dependencies": {
		"@ez-kit/data-grid-core": "workspace:*",
		"@tanstack/react-virtual": "^3.13.23",
		"@tanstack/table-core": "^8.21.3"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	}
}
