{
	"name": "@ez-kit/data-grid-shadcn",
	"version": "0.0.0",
	"private": true,
	"description": "Shadcn package for @ez-kit/data-grid/react.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./global.css": "./src/global.css"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --sourcemap",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"format": "node ../../../../scripts/prettier.mjs --write",
		"format:check": "node ../../../../scripts/prettier.mjs --check",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "500 KB"
		}
	],
	"dependencies": {
		"@ez-kit/data-grid-react": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.577.0",
		"radix-ui": "^1.4.3",
		"react-day-picker": "^10.0.0",
		"shadcn": "^4.1.1",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	}
}
