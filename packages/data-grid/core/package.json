{
	"name": "@ez-kit/data-grid-core",
	"version": "0.1.0",
	"description": "Headless, UI-framework-agnostic data-grid core for @ez-kit/data-grid (built on TanStack Table core).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/data-grid/core"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/data-grid/core#readme",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --sourcemap",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "50 KB"
		}
	],
	"dependencies": {
		"@tanstack/table-core": "^8.21.3"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"zod": ">=3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	}
}
