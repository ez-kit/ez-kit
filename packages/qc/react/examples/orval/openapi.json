{
	"openapi": "3.0.3",
	"info": {
		"title": "Grid users example",
		"version": "1.0.0"
	},
	"paths": {
		"/users": {
			"get": {
				"operationId": "getUsers",
				"parameters": [
					{
						"name": "offset",
						"in": "query",
						"required": true,
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": true,
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "search",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "sort",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UsersPage"
								}
							}
						}
					}
				}
			},
			"post": {
				"operationId": "createUser",
				"parameters": [],
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/User"
								}
							}
						}
					}
				},
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UserValues"
							}
						}
					}
				}
			}
		},
		"/users/feed": {
			"get": {
				"operationId": "getUsersFeed",
				"parameters": [
					{
						"name": "limit",
						"in": "query",
						"required": true,
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "search",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "sort",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UsersFeed"
								}
							}
						}
					}
				}
			}
		},
		"/users/{id}": {
			"patch": {
				"operationId": "updateUser",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/User"
								}
							}
						}
					}
				},
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UserValues"
							}
						}
					}
				}
			},
			"delete": {
				"operationId": "deleteUser",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Success"
					}
				}
			}
		},
		"/users/bulk-delete": {
			"post": {
				"operationId": "deleteUsers",
				"parameters": [],
				"responses": {
					"204": {
						"description": "Success"
					}
				},
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/DeleteUsersBody"
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"User": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					}
				},
				"required": ["id", "name"]
			},
			"UserValues": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					}
				},
				"required": ["name"]
			},
			"UsersPage": {
				"type": "object",
				"properties": {
					"items": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/User"
						}
					},
					"total": {
						"type": "integer"
					}
				},
				"required": ["items", "total"]
			},
			"UsersFeed": {
				"type": "object",
				"properties": {
					"items": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/User"
						}
					},
					"next": {
						"type": "string"
					}
				},
				"required": ["items"]
			},
			"DeleteUsersBody": {
				"type": "object",
				"properties": {
					"ids": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				},
				"required": ["ids"]
			}
		}
	}
}
