{
	"name": "@ez-kit/store-core",
	"version": "0.2.1",
	"description": "A reusable utility package for ez-kit.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/store-core"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/store-core#readme",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./cache": {
			"types": "./dist/cache/index.d.ts",
			"import": "./dist/cache/index.js"
		},
		"./persist": {
			"types": "./dist/persist/index.d.ts",
			"import": "./dist/persist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "5 KB"
		},
		{
			"path": "dist/react.js",
			"limit": "2 KB"
		},
		{
			"path": "dist/cache/index.js",
			"limit": "10 KB"
		},
		{
			"path": "dist/persist/index.js",
			"limit": "2 KB"
		}
	],
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	}
}
