{
	"name": "@ez-kit/form-shadcn",
	"version": "0.5.0",
	"description": "Shadcn UI flavour of @ez-kit/form.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ez-kit/ez-kit",
		"directory": "packages/form/react/shadcn"
	},
	"homepage": "https://github.com/ez-kit/ez-kit/tree/main/packages/form/react/shadcn#readme",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --max-warnings=0 --fix",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"size": "size-limit",
		"clean": "rimraf dist coverage"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "13 KB",
			"ignore": [
				"@base-ui/react",
				"@ez-kit/form-react",
				"class-variance-authority",
				"clsx",
				"date-fns",
				"lucide-react",
				"radix-ui",
				"react-day-picker",
				"tailwind-merge",
				"tailwindcss",
				"tw-animate-css"
			]
		}
	],
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@ez-kit/form-react": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.67.0",
		"radix-ui": "^1.8.1",
		"react-day-picker": "^10.0.2",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	}
}
