{
	"enabledPlugins": {
		"ecc@ecc": true,
		"oh-my-claudecode@omc": true
	},
	"permissions": {
		"allow": [
			"Bash(pnpm typecheck:*)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm test:*)",
			"Bash(pnpm build:*)",
			"Bash(pnpm --filter @ez-kit/zu-store typecheck:*)",
			"Bash(pnpm --filter @ez-kit/zu-store lint:*)",
			"Bash(pnpm --filter @ez-kit/zu-store test:*)",
			"Bash(pnpm --filter @ez-kit/va-store typecheck:*)",
			"Bash(pnpm --filter @ez-kit/va-store lint:*)",
			"Bash(pnpm --filter @ez-kit/va-store test:*)",
			"Bash(pnpm --filter @ez-kit/va-store size:*)",
			"Bash(pnpm --filter @ez-kit/docs lint:*)",
			"Bash(pnpm --filter @ez-kit/docs typecheck:*)"
		]
	}
}
