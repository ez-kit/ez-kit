{
	"$schema": "https://turbo.build/schema.json",
	/* Half the machine's cores, rather than turbo's default.

	   Every package's `test` task is a vitest run that forks its own worker pool, so the two
	   multiply: unbounded, thirteen vitest instances each spawning a pool put ~80 jsdom processes
	   on 8 cores. Tests that take 200 ms alone then blow vitest's 5 s timeout and their workers
	   die with `write EPIPE`, failing a different innocent package on each run.

	   Measured on an 8-core machine, `turbo run test --force`:
	     50%  →  26/26 pass, 72 s, 678% CPU, 0 timeouts
	     13   →  15/25 pass, 92 s, 433% CPU, 3 timeouts
	   The limit is not a trade of speed for reliability — oversubscription was thrashing, so
	   capping it is faster too. A percentage rather than a number so a smaller CI runner scales
	   down with it. */
	"concurrency": "50%",
	/* Root files every package's tasks depend on but none of them contains.

	   Turbo hashes a task from the files inside its own package, so a change to one of these is
	   invisible to it: editing `vitest.shared.ts` — which decides how every suite in the repo is
	   run — replayed all 28 tasks from cache and proved nothing about the change. That is the
	   failure `--force` exists to work around, except nobody knows to reach for it, because a
	   cache hit looks exactly like a pass.

	   Kept deliberately short. Everything here invalidates *every* task in the repo, so a file
	   earns its place only by genuinely changing what a task does. These six do: the test config
	   and its setup file, the tsconfig every package extends, the flat ESLint config, the pinned
	   Node version, and the Prettier config that `pnpm lint` checks against. */
	"globalDependencies": [
		"vitest.shared.ts",
		"vitest.setup.ts",
		"tsconfig.base.json",
		"eslint.config.mjs",
		".nvmrc",
		".prettierrc.json"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**"]
		},
		"lint": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"size": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		}
	}
}
