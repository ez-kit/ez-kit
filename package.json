{
	"name": "ez-kit",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"description": "Monorepo for ez-kit npm UI helper libraries.",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"pkg:new": "turbo gen package",
		"build": "turbo run build",
		"lint": "node ./scripts/check-site-url.mjs && node ./scripts/check-changesets.mjs && turbo run lint",
		"format": "node ./scripts/prettier.mjs --write",
		"format:check": "node ./scripts/prettier.mjs --check",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"verify:affected": "turbo run lint typecheck test --filter=...[HEAD]",
		"test:react18": "pnpm --filter @ez-kit/data-grid-react --filter @ez-kit/form-react --filter @ez-kit/query-react --filter @ez-kit/qc-react run test:react18",
		"size": "turbo run size",
		"clean": "turbo run clean",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build && changeset publish",
		"docs:dev": "pnpm --filter @ez-kit/docs dev",
		"docs:build": "pnpm --filter @ez-kit/docs build",
		"docs:start": "pnpm --filter @ez-kit/docs start",
		"ci": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm size",
		"ci:fast": "pnpm lint && pnpm typecheck && pnpm test",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^9.39.5",
		"@next/eslint-plugin-next": "^16.4.4",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "4.1.12",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"shadcn": "^4.23.0",
		"size-limit": "^14.3.0",
		"tsup": "^9.0.0",
		"turbo": "^2.11.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "4.1.12"
	},
	"pnpm": {
		"overrides": {
			"@babel/core": "^7.29.7",
			"@hono/node-server": "^1.19.18",
			"baseline-browser-mapping": "^2.11.0",
			"body-parser": "^2.4.0",
			"brace-expansion@1": "^1.1.21",
			"brace-expansion@5": "^5.0.12",
			"browserslist": "^4.28.7",
			"fast-uri": "^3.1.9",
			"fflate": "^0.8.3",
			"hono": "^4.13.16",
			"ip-address": "^10.7.5",
			"js-yaml@3": "^3.15.2",
			"js-yaml@4": "^4.3.2",
			"nanoid@3": "^3.3.18",
			"nanoid@5": "^5.1.16",
			"postcss": "^8.5.18",
			"postcss-selector-parser": "^7.1.3",
			"undici": "^7.30.1",
			"vite": "^8.3.5",
			"source-map-js": "^1.2.2",
			"rimraf>glob": "^14.0.2",
			"minimatch@10": "^11.0.1"
		}
	}
}
