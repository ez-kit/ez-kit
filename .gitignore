# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnpm-store
/.pnp
.pnp.js
.source
# testing
/coverage
# Per-package coverage output. The root-anchored line above only ever matched the root,
# so a package's own report — which `pnpm --filter <pkg> test:coverage` writes — leaked in.
**/coverage

# playwright
playwright-report/
test-results/

# task-flow-execute visual-check scratch (screenshots/snapshots; published as release assets, never committed)
**/.visual/

# task-flow-execute agent-gate/agent-push scratch (full gate command logs; tail printed to stdout, never committed)
**/.agent-logs/

.agents/skills/
.claude/skills/
.claude/commands

openspec
.specify

.playwright-mcp

# playwright snapshots
apps/docs/tests/**/*.png

# next.js
/.next/
/out/
.next


# production
/build
**/dist

# task runner cache
.turbo

# misc
.DS_Store
*.pem

.omc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
