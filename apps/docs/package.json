{
	"name": "@ez-kit/docs",
	"version": "0.0.1",
	"private": true,
	"description": "Documentation site for ez-kit packages (Fumadocs + Next.js).",
	"type": "module",
	"scripts": {
		"dev": "pnpm sandpack:build && next dev",
		"build": "pnpm sandpack:build && next build",
		"start": "next start",
		"lint": "pnpm sandpack:build && eslint .",
		"format": "node ../../scripts/prettier.mjs --write",
		"format:check": "node ../../scripts/prettier.mjs --check",
		"typecheck": "pnpm sandpack:build && next typegen && tsc --project tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:visual": "pnpm sandpack:build && playwright test",
		"test:visual:update": "pnpm sandpack:build && playwright test --update-snapshots",
		"sandpack:build": "node scripts/build-sandpack.mjs",
		"size": "echo \"size check skipped for docs app\"",
		"clean": "rimraf .next"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@codesandbox/sandpack-react": "^2.20.0",
		"@ez-kit/data-grid-core": "workspace:*",
		"@ez-kit/data-grid-heroui": "workspace:*",
		"@ez-kit/data-grid-react": "workspace:*",
		"@ez-kit/data-grid-shadcn": "workspace:*",
		"@ez-kit/zu-store": "workspace:*",
		"@react-three/fiber": "^9.6.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^12.38.0",
		"fumadocs-core": "16.8.5",
		"fumadocs-mdx": "14.3.2",
		"fumadocs-ui": "16.8.5",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.577.0",
		"next": "16.2.4",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^19.2.5",
		"react-day-picker": "^10.0.0",
		"react-dom": "^19.2.5",
		"react-resizable-panels": "^4.11.1",
		"recharts": "3.8.0",
		"shadcn": "^4.7.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"three": "^0.184.0",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/mdx": "^2.0.13",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.184.0",
		"tailwindcss": "^4.1.18"
	}
}
