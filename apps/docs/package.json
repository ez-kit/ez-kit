{
	"name": "@ez-kit/docs",
	"version": "0.0.0",
	"private": true,
	"description": "Documentation site for ez-kit packages (Fumadocs + Next.js).",
	"type": "module",
	"scripts": {
		"dev": "pnpm sandpack:build && next dev",
		"build": "pnpm sandpack:build && next build",
		"start": "next start",
		"lint": "pnpm sandpack:build && eslint .",
		"format": "node ../../scripts/prettier.mjs --write",
		"format:check": "node ../../scripts/prettier.mjs --check",
		"typecheck": "pnpm sandpack:build && tsc --project tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:visual": "pnpm sandpack:build && playwright test",
		"test:visual:update": "pnpm sandpack:build && playwright test --update-snapshots",
		"sandpack:build": "node scripts/build-sandpack.mjs",
		"size": "echo \"size check skipped for docs app\"",
		"clean": "rimraf .next"
	},
	"dependencies": {
		"@codesandbox/sandpack-react": "^2.20.0",
		"@ez-kit/data-grid-core": "workspace:*",
		"@ez-kit/data-grid-heroui": "workspace:*",
		"@ez-kit/data-grid-react": "workspace:*",
		"@ez-kit/data-grid-shadcn": "workspace:*",
		"fumadocs-core": "^15.8.5",
		"fumadocs-ui": "^15.8.5",
		"lucide-react": "^0.577.0",
		"next": "^15.5.14",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.1.18"
	}
}
