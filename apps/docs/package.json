{
	"name": "@ez-kit/docs",
	"version": "0.3.1",
	"private": true,
	"description": "Documentation site for ez-kit packages (Fumadocs + Next.js).",
	"type": "module",
	"imports": {
		"#globals.css": "./app/globals.css"
	},
	"scripts": {
		"dev": "pnpm build:deps && pnpm registry:build && node scripts/dev-server.mjs",
		"build": "pnpm build:deps && pnpm registry:build && next build",
		"build:deps": "turbo run build --filter=@ez-kit/docs^...",
		"registry:build": "node scripts/build-registry.mjs",
		"start": "next start",
		"lint": "next typegen && eslint .",
		"typecheck": "next typegen && fumadocs-mdx && tsc --project tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:e2e": "playwright test --grep-invert @smoke",
		"test:e2e:smoke": "playwright test --grep @smoke --workers=4",
		"test:e2e:update": "playwright test --grep-invert @smoke --update-snapshots",
		"size": "echo \"size check skipped for docs app\"",
		"clean": "rimraf .next"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@dnd-kit/react": "^0.5.3",
		"@ez-kit/data-grid-core": "workspace:*",
		"@ez-kit/data-grid-heroui": "workspace:*",
		"@ez-kit/data-grid-react": "workspace:*",
		"@ez-kit/data-grid-shadcn": "workspace:*",
		"@ez-kit/form-core": "workspace:*",
		"@ez-kit/form-heroui": "workspace:*",
		"@ez-kit/form-react": "workspace:*",
		"@ez-kit/form-shadcn": "workspace:*",
		"@ez-kit/query-react": "workspace:*",
		"@ez-kit/twc": "workspace:*",
		"@ez-kit/va-store": "workspace:*",
		"@ez-kit/zu-store": "workspace:*",
		"@heroui/react": "^3.2.7",
		"@heroui/styles": "^3.2.7",
		"@react-three/fiber": "^9.8.2",
		"@tanstack/react-query": "^5.105.3",
		"@tanstack/react-store": "^0.11.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^14.9.0",
		"fumadocs-core": "16.17.10",
		"fumadocs-mdx": "15.4.10",
		"fumadocs-ui": "16.17.10",
		"input-otp": "^1.5.0",
		"lucide-react": "^1.67.0",
		"next": "16.4.4",
		"next-themes": "^0.4.6",
		"qs": "^6.17.1",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-resizable-panels": "^4.17.0",
		"recharts": "3.10.1",
		"sass": "^1.107.1",
		"server-only": "^0.0.1",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"three": "^0.187.0",
		"tw-animate-css": "^1.4.0",
		"valtio": "^2.3.2",
		"vaul": "^1.1.2",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@react-aria/ssr": "^3.10.1",
		"@react-aria/utils": "^3.34.1",
		"@tailwindcss/postcss": "^4.3.4",
		"@types/mdx": "^2.0.14",
		"@types/node": "^22.20.5",
		"@types/qs": "^6.15.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.187.0",
		"esbuild": "^0.28.2",
		"react-aria": "^3.53.1",
		"react-aria-components": "^1.22.1",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3"
	}
}
