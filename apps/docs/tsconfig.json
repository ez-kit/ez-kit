{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": false,
		"target": "ESNext",
		"jsx": "preserve",
		"incremental": true,
		"isolatedModules": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"plugins": [
			{
				"name": "next"
			}
		],
		"types": ["node", "@testing-library/jest-dom/vitest"],
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./*"],
			"collections/*": ["./.source/*"],
			"@grid-shadcn/*": ["../../packages/data-grid/react/shadcn/src/*"],
			"*": ["./*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.d.ts", "**/*.tsx", "**/*.mdx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
